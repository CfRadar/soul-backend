# SoulDuel Backend Configuration

# Server Port (default 3001)
PORT=3001

# MongoDB Connection URI (e.g. local mongodb or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/soulduel

# JWT Secret Key used for signing player tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# Optional / Legacy OTP configuration (deprecated with password auth)
# APPS_SCRIPT_URL=
# OTP_SHARED_SECRET=
